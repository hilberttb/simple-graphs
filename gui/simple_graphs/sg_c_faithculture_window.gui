###############################################################################
# Simple Graphs - connected line graph, driven by a faith/culture picker.
#
# Two columns:
#   x   0 ..  684   the plot, with a y label at each end of the line. Shows
#                   whichever faith or culture is selected.
#   x 700 .. 1130   the picker. Every row is a click target.
#
# There is exactly ONE plot. Comparing two series side by side is deliberately
# not a feature - the window briefly showed two during the migration off the
# catholic hardcode, and that scaffolding is gone.
#
# Selection REQUIRES A PLAYED CHARACTER. A scripted GUI's Execute does not run
# at all in Observer mode, so the rows are inert there; the window says so on
# screen. Everything else here is a pure read and works in Observer. Full
# reasoning in common/scripted_guis/sg_c_faithculture_select.txt.
#
# ---------------------------------------------------------------------------
# COORDINATES
# ---------------------------------------------------------------------------
# Script hands the GUI one packed number per segment:
#     entry = snapshot_index * 1000000 + y_start * 1000 + y_end
# with y already a pixel offset in a 300px-tall plot and already flipped for
# GUI coordinates. See sg_engine_append_point_effect.
#
#     y_start = Modulo_int32( Divide_int32( v, 1000 ), 1000 )
#     y_end   = Modulo_int32( v, 1000 )
#     x_start = index * STEP    x_end = (index + 1) * STEP
#
# Divide_int32 is only used to shift the packed value right by one field, and
# it is safe whether it truncates or rounds to nearest: y_end is at most 300,
# so the discarded remainder is never at or above half a unit and can never
# round the quotient up. Nothing here depends on knowing which it does.
#
# x comes from PdxGuiWidget.GetIndexInDataModel, which is real and widely used
# in vanilla (hud.gui:7952, hud_ruler_objective.gui:198, and ~20 more sites),
# so no script-side x list is needed.
#
# ---------------------------------------------------------------------------
# THE X STEP AUTO-FITS. It used to be a hardcoded 30px.
# ---------------------------------------------------------------------------
#     STEP = Divide_float( '(float)600',
#                IntToFloat( Max_int32( GetDataModelSize( <the segment list> ),
#                                       '(int32)1' ) ) )
#
# At a fixed 30px the plot held only 20 segments before the line ran past the
# plot area and then past the window itself. The series now always fills the
# 600px plot exactly and CAN NEVER LEAVE IT, whatever the snapshot count.
#
# The accepted trade, decided deliberately: the x axis COMPRESSES as snapshots
# accumulate instead of staying 30px per year. Spacing is therefore not
# comparable between two objects with different history lengths.
#
# Max_int32( ..., 1 ) is the divide-by-zero guard. An object with a single
# snapshot has ZERO segments, and 600/0 would be undefined; the guard makes the
# step 600 and the lone point sits at x = 0, which is correct because there is
# no line to draw anyway.
#
# DO NOT "fix" the compression by wrapping the plot in a horizontally scrolling
# scrollbox. That was tried on 2026-09-12 and does not work: no scrollbar
# appeared, nothing was clipped, and the line drew straight across the whole
# screen at 43 segments. The data-bound size on the content widget DID take
# effect and the numbers panel in this same window scrolls vertically without
# trouble, so the failure is specific to scrolling a container of `line`
# widgets. Vanilla's domicile precedent proves lines RENDER inside a scrollbox,
# not that they SCROLL inside one. This auto-fit is what replaced that idea.
#
# The divisor is the SEGMENT list, not the year list - see the x-axis block
# below, whose labels must land on the same step or they drift off the points.
#
# ---------------------------------------------------------------------------
# SCROLLAREAS
# ---------------------------------------------------------------------------
# GUI_RESEARCH.md open question #5 asked whether a `line` survives inside a
# scrollarea. Vanilla already answers it: vbox_domicile_upgrade_tree
# (window_domicile.gui:3508) contains data-bound `line` widgets and is rendered
# inside a scrollbox via blockoverride "scrollbox_content"
# (window_domicile.gui:3177-3199), with both scrollbars set to as_needed. So
# lines do render inside a scrollarea in shipping code. The plot below is still
# kept out of any scrollarea, to keep the prototype's failure modes few.
#
# Note also that the vanilla templates which live inside that scrollbox
# (Line_Domicile_*) do NOT set effectname, i.e. they use the default line
# effect rather than PdxGuiLineScreenSpace. The templates below follow them.
###############################################################################

# The line style lives in gui/simple_graphs/sg_engine_plot.gui as the template
# sg_engine_line_data. Cross-file template references are load-order safe -
# that file records the vanilla evidence.

window = {
	name = "sg_c_faithculture_window"
	datacontext = "[GetVariableSystem]"

	parentanchor = center
	# 680x620 -> 1180x700 -> 1750x700 while two plots were on screen for the
	# catholic migration -> 1090x700 once only the selection plot remained ->
	# 1150x700 to fit the two y labels, which pushed the picker column from
	# x 660 to x 700.
	# The plot keeps its 600x300 size: the 300px height is fixed by the script's
	# 0-300 y scale and must not change without changing
	# sg_engine_append_point_effect's Y_MAX argument to match.
	size = { 1150 700 }
	layer = windows_layer
	movable = yes

	visible = "[GetVariableSystem.Exists( 'sg_window_open' )]"

	# Background as a child widget rather than a property on the window itself,
	# so nothing depends on a template this prototype has not verified.
	widget = {
		size = { 100% 100% }
		background = {
			texture = "gfx/interface/colors/black.dds"
			alpha = 0.92
		}
	}

	### close button ##########################################################
	# All that is left of the header. The window title went with everything else
	# that used to sit above the graph; this button is anchored top|right, over
	# the picker column, so it never touches the paper.
	button_standard = {
		parentanchor = top|right
		position = { -16 10 }
		size = { 90 28 }
		text = "SG_ENGINE_CLOSE"
		onclick = "[GetVariableSystem.Toggle( 'sg_window_open' )]"
	}

	### THE PLOT ################################################################
	# Names no faith and no culture anywhere. Plots whatever was last clicked in
	# the picker on the right.
	#
	# The 600x300 size is not arbitrary: the 300px height is fixed by the 0-300
	# pixel y scale that sg_engine_append_point_effect encodes into
	# every packed segment, and must not change without changing that effect.
	#
	# -------------------------------------------------------------------------
	# HOW A SELECTION GETS HERE
	# -------------------------------------------------------------------------
	# Clicking a row runs common/scripted_guis/sg_c_faithculture_select.txt,
	# which writes the clicked object's SCOPE into a global variable. The chain
	# back out, every link confirmed in logs/data_types/:
	#
	#   GetGlobalVariable( 'name' )  Global promote -> Scope  script.txt:364
	#     .Faith / .Culture          Promote -> Faith/Culture script.txt:2923 / :2853
	#       .MakeScope               Promote -> Scope         uncategorized.txt:61019 / :49608
	#         .GetList( 'name' )     Function -> datamodel    script.txt:3429
	#
	# Only the FIRST link is new. The other three are exactly what the picker
	# column on the right already does per row, and they were verified in-game on
	# 2026-09-13 (real names, pts = snapshots taken, seg = pts - 1). The first
	# link is the same shape as the already-working
	# GetGlobalVariable( 'sg_snapshot_index' ).GetValue in the counter
	# row of the left column.
	#
	# -------------------------------------------------------------------------
	# WHY EVERYTHING BELOW EXISTS TWICE
	# -------------------------------------------------------------------------
	# A selection is either a Faith or a Culture, and `line` needs one datamodel.
	# The alternative design - one generic global plus a type flag, letting the
	# GUI ask whether .Faith "works" on it - was rejected because a mistyped
	# promote's behaviour is not confirmable: `Scope.<Type>.IsValid` appears
	# ZERO times across game/gui, jomini/gui, clausewitz/gui and all 28 installed
	# workshop mods. Nothing in shipped code ever calls a Scope type-promote
	# where the type might be wrong, so there is no evidence it degrades quietly
	# rather than erroring or spamming.
	#
	# So the type is carried structurally instead: two globals, only one ever set
	# at a time, each only ever holding its own type. Each pair of widgets below
	# is guarded by `.IsSet` on its own global, which is a plain bool
	# (Scope.IsSet, data_types_script.txt:3550) on a type the widget already
	# knows. The two are mutually exclusive by construction, so exactly one plot
	# is ever on screen - the "one graph at a time" scope limit is enforced by
	# the data model rather than by a rule someone has to remember.
	#
	# The cost is that the faith block and the culture block below are textually
	# near-identical. That is the accepted trade.
	#
	# -------------------------------------------------------------------------
	# THE LINE EXPRESSIONS ARE UNCHANGED FROM THE PROTOTYPE
	# -------------------------------------------------------------------------
	# The `from`/`to` expressions below are character-for-character what the
	# original catholic-hardcoded plot used; only the datamodel source differs.
	# That equality was the whole basis of the migration check: on 2026-09-13,
	# selecting Catholic here reproduced the hardcoded plot segment for segment,
	# and every number column matched value for value, which is what licensed
	# deleting the hardcode.
	#
	# The faith and culture blocks below are near-identical rather than sharing a
	# template. See "WHY EVERYTHING BELOW EXISTS TWICE" above - they bind
	# different datamodels and only one is ever visible.


	### THE PAPER ##############################################################
	# The whole left half of the window is a sheet now, not just a rectangle
	# behind the plot. x 0..696 stops 4px short of the picker column at x 700, so
	# that black gutter is the only thing dividing the two halves - the right-hand
	# column deliberately keeps the dark window style.
	#
	# Declared FIRST among the window's visible children so everything else draws
	# on top of it. The window's own black background widget is still underneath,
	# and is what the picker column sits on.
	#
	# THE TILES ARE Background_Letter_Default's, INLINED. Same three textures,
	# same blend modes, same sprite types, copied from
	# game/gui/shared/backgrounds.gui:401-425, with one number changed:
	# spriteborder 200 -> 40. The stock 200 assumes a panel over 400px tall and
	# silently loses the tileable middle below that; 40 keeps the ragged paper
	# edge, which is only about 15px of the 900x740 texture, and tiles the uniform
	# middle. `using` had to be given up because a template's internals cannot be
	# overridden from outside it.
	#
	# The _Default variant rather than Background_Letter: the latter reads its
	# tiles from gfx/interface/skinned/window_letter/, which the game reskins per
	# culture group, so the sheet would change shade depending on who is being
	# played and the ink and the axis text would have nothing fixed to contrast
	# against.
	widget = {
		name = "sg_c_fc_paper"
		position = { 0 0 }
		size = { 696 700 }

		background = {
			name = "paper_texture_shadow"
			texture = "gfx/interface/component_tiles/tile_letter_shadow.dds"
			spriteType = Corneredtiled
			spriteborder = { 40 40 }
		}

		background = {
			name = "paper_texture_flat"
			texture = "gfx/interface/component_tiles/tile_letter_flat.dds"
			spriteType = Corneredtiled
			spriteborder = { 40 40 }

			modify_texture = {
				name = "paper_texture_overlay"
				texture = "gfx/interface/component_tiles/overlay_letter_texture.dds"
				spriteType = Corneredstretched
				blend_mode = overlay
			}
		}
	}

	widget = {
		name = "sg_c_fc_sel_plot_area"
		position = { 46 200 }
		size = { 600 300 }
		allow_outside = yes

		# NO BACKGROUND HERE. The paper is drawn by sg_c_fc_sel_plot_paper, the
		# sibling declared immediately above, which is deliberately LARGER than
		# this widget. See that widget for why.
		#
		# This widget stays exactly 600x300 at exactly { 40 138 }. The 300 is the
		# number sg_engine_append_point_effect encodes every packed segment
		# against, and the whole point of moving the paper out is that the paper
		# can now be resized for looks without this going anywhere near it.

		### THE TWO NOTICES ####################################################
		# Both sit in the middle of the plot and both explain an empty one. They are
		# children of the plot area rather than free-floating widgets so that
		# "centre of the graph" needs no arithmetic - parentanchor does it, and it
		# keeps doing it if the plot ever moves or resizes.
		#
		# Mutually exclusive by construction: one requires GetPlayer to be invalid
		# and the other requires it to be valid.
		#
		# Dark text, because this is on paper now. default_format plus
		# Text_Light_Background_Overrides is the pair vanilla uses on this same
		# letter background (window_activity_list.gui:594-595). The format resolves
		# to color_black, { 0.1 0.1 0.03 }, which is the ink the line is drawn in.
		widget = {
			name = "sg_c_fc_plot_notices"
			size = { 100% 100% }

			# Observer mode. A scripted GUI's Execute does not run AT ALL without a
			# played character - confirmed 2026-09-13 by clicking four different
			# routes into script, including two that never touch GetPlayer, and
			# getting zero debug output from any of them; the moment a character was
			# selected, all four fired. The picker is genuinely inert here and the
			# honest thing is to say so rather than let it look broken. Full
			# reasoning in common/scripted_guis/sg_c_faithculture_select.txt.
			#
			# This moved into the plot from above it: with the left half now a sheet
			# carrying nothing but the graph, the empty graph is where an
			# explanation for an empty graph belongs.
			#
			# GetPlayer.IsValid as the availability test is the vanilla-style guard
			# and is what workshop mod 3118461885 uses on its own floating button
			# (HRT_floating_button.gui:5).
			text_single = {
				parentanchor = center
				visible = "[Not( GetPlayer.IsValid )]"
				text = "SG_C_FC_LBL_OBSERVER"
				default_format = "#light_background"
				using = Text_Light_Background_Overrides
				alwaystransparent = yes
			}

			# Fewer than two snapshots. A series needs TWO points before any line
			# exists, so in a campaign's first year every selection plots nothing and
			# the blankness has nothing to do with which row was clicked.
			#
			# The Or covers the moment before the first snapshot has ever run, when
			# the global does not exist yet. Reading .GetValue off an unset global
			# yields 0, which would satisfy the comparison on its own - but leaning
			# on that is exactly what went wrong in phase 8: an unset colour variable
			# read as 0 and drew a black line for two runs before anyone asked why.
			# Ask the question that is actually meant instead.
			text_single = {
				parentanchor = center
				visible = "[And( GetPlayer.IsValid, Or( Not( GetGlobalVariable( 'sg_snapshot_index' ).IsSet ), LessThan_int32( FixedPointToInt( GetGlobalVariable( 'sg_snapshot_index' ).GetValue ), '(int32)2' ) ) ) ]"
				text = "SG_C_FC_LBL_NEEDSNAPSHOTS"
				default_format = "#light_background"
				using = Text_Light_Background_Overrides
				alwaystransparent = yes
			}
		}

		# --- selection is a FAITH --------------------------------------------
		widget = {
			name = "sg_c_fc_sel_series_faith"
			size = { 100% 100% }
			allow_outside = yes

			visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
			datamodel = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' )]"

			item = {
				container = {
					allow_outside = yes

					line = {
						using = sg_engine_line_data
						# --- THE SERIES COLOUR -------------------------------------
						# Overrides the ink literal in sg_engine_line_data. Vanilla
						# overrides a property a `using`d template set in 160 places
						# (window_activity.gui:2257 does it to Background_Bottom_Fade's
						# alpha, frontend_bookmarks.gui:4015 to portrait_base's texture),
						# so the override itself is ordinary.
						#
						# WHAT IS *NOT* ORDINARY, AND MUST BE CHECKED IN GAME: binding
						# an expression to a `line`'s colour has NO vanilla precedent.
						# game/gui, jomini/gui and clausewitz/gui contain 9 `line`
						# widgets in total, in three files, and not one binds `color`;
						# of the 12 templates in shared/lines.gui only 2 set a colour and
						# both are literals. Databound `color` is itself ordinary - 32
						# sites, 20 distinct expressions, e.g. Artifact.GetRarityColor -
						# just never on this widget.
						#
						# THE FAILURE MODE IS DESIGNED TO BE SURVIVABLE. If this binding
						# does nothing, the template's { 0.1 0.1 0.03 } stands and the
						# plot is exactly what it was before colour existed - a legible
						# dark line on paper - rather than an invisible or absent one.
						# That is why the literal stayed in the template instead of being
						# moved out here.
						#
						# WHERE THE THREE NUMBERS COME FROM
						#   sg_c_faithculture_colors.txt  the authored colour, generated
						#                                 from the CK3 install's own files
						#                                 because nothing exposes it at
						#                                 runtime
						#   sg_engine_palette.txt         a rotor-assigned palette colour
						#                                 for anything that table cannot
						#                                 know: reformed faiths, hybrid and
						#                                 divergent cultures, other mods
						#
						# Stored as three 0..1 fractions rather than one packed number so
						# that FixedPointToFloat is the whole decode.
						#
						# The read is <Type>.MakeScope.Var( 'name' ).GetValue. It was
						# .GetVariable( 'name' ) on the first run, which drew every series
						# in the ink colour; Var was swapped in because vanilla GUI uses
						# it 81 times and GetVariable zero times. THAT IS NOT WHY THE
						# FIRST RUN FAILED, and the record should not imply it was: the
						# picker's own county column further down this file reads
						# Faith.MakeScope.GetVariable( 'sg_faithculture_counties_now' )
						# .GetValue and has rendered real numbers since 2026-09-13. Both
						# promotes work. Var is kept only because it is the attested form.
						#
						# The actual cause is still open, and the diagnostic row near the
						# bottom of this window plus the literal control on the culture
						# line below are what will close it. The packing the rest
						# of this mod uses exists because add_to_variable_list
						# de-duplicates by value; these are plain variables, so none of
						# that applies and there is nothing to unpack, no radix to get
						# right and no Divide_int32 rounding question to reason about.
						#
						# Script writes all three the moment an object becomes trackable,
						# so they are set before a row exists to click. The one gap is a
						# save made before 0.2.0, whose objects are stamped on its next
						# snapshot - at most one in-game year during which this reads an
						# unset variable.
						color = "[FloatToCVector4f( FixedPointToFloat( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.Var( 'sg_faithculture_color_r' ).GetValue ), FixedPointToFloat( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.Var( 'sg_faithculture_color_g' ).GetValue ), FixedPointToFloat( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.Var( 'sg_faithculture_color_b' ).GetValue ), '(float)1' )]"

						from = "[FloatToCVector2f( Multiply_float( IntToFloat( PdxGuiWidget.GetIndexInDataModel ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), IntToFloat( Modulo_int32( Divide_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ), '(int32)1000' ) ) )]"
						to = "[FloatToCVector2f( Multiply_float( IntToFloat( Add_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)1' ) ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), IntToFloat( Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ) ) )]"
					}
				}
			}
		}

		# --- selection is a CULTURE ------------------------------------------
		widget = {
			name = "sg_c_fc_sel_series_culture"
			size = { 100% 100% }
			allow_outside = yes

			visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
			datamodel = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' )]"

			item = {
				container = {
					allow_outside = yes

					line = {
						using = sg_engine_line_data
						# --- THE SERIES COLOUR -------------------------------------
						# Overrides the ink literal in sg_engine_line_data. Vanilla
						# overrides a property a `using`d template set in 160 places
						# (window_activity.gui:2257 does it to Background_Bottom_Fade's
						# alpha, frontend_bookmarks.gui:4015 to portrait_base's texture),
						# so the override itself is ordinary.
						#
						# WHAT IS *NOT* ORDINARY, AND MUST BE CHECKED IN GAME: binding
						# an expression to a `line`'s colour has NO vanilla precedent.
						# game/gui, jomini/gui and clausewitz/gui contain 9 `line`
						# widgets in total, in three files, and not one binds `color`;
						# of the 12 templates in shared/lines.gui only 2 set a colour and
						# both are literals. Databound `color` is itself ordinary - 32
						# sites, 20 distinct expressions, e.g. Artifact.GetRarityColor -
						# just never on this widget.
						#
						# THE FAILURE MODE IS DESIGNED TO BE SURVIVABLE. If this binding
						# does nothing, the template's { 0.1 0.1 0.03 } stands and the
						# plot is exactly what it was before colour existed - a legible
						# dark line on paper - rather than an invisible or absent one.
						# That is why the literal stayed in the template instead of being
						# moved out here.
						#
						# WHERE THE THREE NUMBERS COME FROM
						#   sg_c_faithculture_colors.txt  the authored colour, generated
						#                                 from the CK3 install's own files
						#                                 because nothing exposes it at
						#                                 runtime
						#   sg_engine_palette.txt         a rotor-assigned palette colour
						#                                 for anything that table cannot
						#                                 know: reformed faiths, hybrid and
						#                                 divergent cultures, other mods
						#
						# Stored as three 0..1 fractions rather than one packed number so
						# that FixedPointToFloat is the whole decode.
						#
						# The read is <Type>.MakeScope.Var( 'name' ).GetValue. It was
						# .GetVariable( 'name' ) on the first run, which drew every series
						# in the ink colour; Var was swapped in because vanilla GUI uses
						# it 81 times and GetVariable zero times. THAT IS NOT WHY THE
						# FIRST RUN FAILED, and the record should not imply it was: the
						# picker's own county column further down this file reads
						# Faith.MakeScope.GetVariable( 'sg_faithculture_counties_now' )
						# .GetValue and has rendered real numbers since 2026-09-13. Both
						# promotes work. Var is kept only because it is the attested form.
						#
						# The actual cause is still open, and the diagnostic row near the
						# bottom of this window plus the literal control on this culture
						# line are what will close it. The packing the rest
						# of this mod uses exists because add_to_variable_list
						# de-duplicates by value; these are plain variables, so none of
						# that applies and there is nothing to unpack, no radix to get
						# right and no Divide_int32 rounding question to reason about.
						#
						# Script writes all three the moment an object becomes trackable,
						# so they are set before a row exists to click. The one gap is a
						# save made before 0.2.0, whose objects are stamped on its next
						# snapshot - at most one in-game year during which this reads an
						# unset variable.
						# The literal control that ran here on run 2 is gone. It did its
						# job: with color = { 0.85 0.10 0.10 1.0 } every culture line drew
						# RED, which proves a `line` DOES honour a `color` set after
						# `using`. Candidate (b) - "the template always wins" - is dead,
						# and sg_engine_line_data can keep its ink literal as the safety
						# net without that costing anything.
						color = "[FloatToCVector4f( FixedPointToFloat( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.Var( 'sg_faithculture_color_r' ).GetValue ), FixedPointToFloat( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.Var( 'sg_faithculture_color_g' ).GetValue ), FixedPointToFloat( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.Var( 'sg_faithculture_color_b' ).GetValue ), '(float)1' )]"

						from = "[FloatToCVector2f( Multiply_float( IntToFloat( PdxGuiWidget.GetIndexInDataModel ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), IntToFloat( Modulo_int32( Divide_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ), '(int32)1000' ) ) )]"
						to = "[FloatToCVector2f( Multiply_float( IntToFloat( Add_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)1' ) ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), IntToFloat( Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ) ) )]"
					}
				}
			}
		}
	}

	### THE Y LABELS - FIRST AND LAST VALUE OF THE SERIES #######################
	# Two numbers only, not a full y axis: the county count at the object's
	# FIRST snapshot, sitting just left of the plot, and the count at its LAST
	# snapshot, sitting just right of it. Each is placed at the y of its own
	# point, so it reads as an annotation of the line's two ends rather than as
	# a legend.
	#
	# ---------------------------------------------------------------------
	# WHY THE PLAIN LIST AND NOT THE SEGMENT LIST
	# ---------------------------------------------------------------------
	# The segment list already carries pixel y values, so it would give the
	# position for free - but it does NOT carry the county count, which is the
	# thing being labelled, and it is one entry SHORT (N snapshots, N-1
	# segments) so its index 0 is the first SEGMENT, not the first point.
	# The plain list carries the count and is exactly one entry per snapshot,
	# so both the text and the endpoint indices come from one list.
	#
	# The cost is that the pixel y has to be recomputed here from the count,
	# duplicating what sg_engine_append_point_effect did at write time:
	#
	#     y = Y_MAX - min( value * Y_SCALE, Y_MAX )
	#
	# with Y_SCALE = 0.3 and Y_MAX = 300, the two values this consumer passes
	# to that effect in sg_c_faithculture_collect.txt. THOSE NUMBERS ARE NOW
	# WRITTEN DOWN IN TWO PLACES - change Y_SCALE or Y_MAX there and these
	# labels drift off the line with no error anywhere.
	#
	# The engine round_variable's to the nearest pixel and this does not, so a
	# label can sit up to half a pixel off its point. That is invisible and is
	# not worth a rounding helper.
	#
	# Min_float (data_types_common.txt:896) reproduces the engine's
	# clamp_variable max, which matters for any object above 1000 counties: the
	# line pins to the top edge there, and without the Min the label would keep
	# climbing off the plot and part company with the line it annotates. The
	# engine's matching min-0 clamp has no counterpart here on purpose - a
	# county count cannot be negative.
	#
	# The trailing -10 lifts the label by half a 20px text row so the row is
	# centred on the point rather than hanging below it.
	#
	# ---------------------------------------------------------------------
	# PICKING THE TWO ENDS
	# ---------------------------------------------------------------------
	# There is no way to index a datamodel from GUI - no GetItem, no GetFirst,
	# nothing of the sort exists anywhere in logs/data_types/. So each label is
	# a full datamodel over the whole list with every item but one hidden, the
	# same trick the x axis below uses to thin its labels. Index 0 is the
	# first point; GetDataModelSize - 1 is the last.
	#
	# A one-snapshot object shows the same number on both sides, which is
	# correct: its first point IS its last point. An object with no snapshots
	# has an empty list and shows neither label.
	#
	# Four near-identical blocks for the usual two reasons - two ends, and a
	# selection that is either a Faith or a Culture with no polymorphic
	# accessor that would let one block serve both. See "WHY EVERYTHING BELOW
	# EXISTS TWICE" above.
	widget = {
		name = "sg_c_fc_ylabel_start"
		# x 0..36 leaves a 4px gap before the plot's left edge at x = 40. The y
		# origin is the plot's own, so the item positions below are plot-local.
		position = { 6 200 }
		size = { 36 300 }
		allow_outside = yes

		# --- selection is a FAITH ----------------------------------------
		widget = {
			name = "sg_c_fc_ylabel_start_faith"
			size = { 100% 100% }
			allow_outside = yes

			# Gated on the SEGMENT count, not just on "something is selected".
			# Zero segments means no line was drawn, and a y/x label with no line
			# under it is an annotation of nothing - which is exactly what a
			# one-snapshot campaign used to show. N snapshots give N-1 segments,
			# so this is false for both the "no snapshots yet" and the "only one
			# snapshot" cases, and stays false for an object whose OWN history is
			# one point long even when the campaign's is fifty.
			visible = "[And( GetGlobalVariable( 'sg_selected_faith' ).IsSet, GreaterThan_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)0' ) )]"
			datamodel = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties' )]"

			item = {
				widget = {
					size = { 36 20 }
					allow_outside = yes

					visible = "[EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' )]"
					position = "[FloatToCVector2f( '(float)0', Subtract_float( Subtract_float( '(float)300', Min_float( Multiply_float( IntToFloat( FixedPointToInt( Scope.GetValue ) ), '(float)0.3' ), '(float)300' ) ), '(float)10' ) )]"

					# align = right so the number ends against the plot edge
					# whatever its digit count. autoresize = no is what makes
					# align mean anything - vanilla pairs the two the same way
					# at hud.gui:1278-1288.
					text_single = {
						position = { 0 0 }
						size = { 36 20 }
						autoresize = no
						align = right|nobaseline
						text = "[FixedPointToInt( Scope.GetValue )]"
						default_format = "#light_background"
						using = Text_Light_Background_Overrides
						alwaystransparent = yes
					}
				}
			}
		}

		# --- selection is a CULTURE --------------------------------------
		widget = {
			name = "sg_c_fc_ylabel_start_culture"
			size = { 100% 100% }
			allow_outside = yes

			# Gated on the SEGMENT count, not just on "something is selected".
			# Zero segments means no line was drawn, and a y/x label with no line
			# under it is an annotation of nothing - which is exactly what a
			# one-snapshot campaign used to show. N snapshots give N-1 segments,
			# so this is false for both the "no snapshots yet" and the "only one
			# snapshot" cases, and stays false for an object whose OWN history is
			# one point long even when the campaign's is fifty.
			visible = "[And( GetGlobalVariable( 'sg_selected_culture' ).IsSet, GreaterThan_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)0' ) )]"
			datamodel = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties' )]"

			item = {
				widget = {
					size = { 36 20 }
					allow_outside = yes

					visible = "[EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' )]"
					position = "[FloatToCVector2f( '(float)0', Subtract_float( Subtract_float( '(float)300', Min_float( Multiply_float( IntToFloat( FixedPointToInt( Scope.GetValue ) ), '(float)0.3' ), '(float)300' ) ), '(float)10' ) )]"

					text_single = {
						position = { 0 0 }
						size = { 36 20 }
						autoresize = no
						align = right|nobaseline
						text = "[FixedPointToInt( Scope.GetValue )]"
						default_format = "#light_background"
						using = Text_Light_Background_Overrides
						alwaystransparent = yes
					}
				}
			}
		}
	}

	widget = {
		name = "sg_c_fc_ylabel_end"
		# x 644..684, i.e. a 4px gap after the plot's right edge at x = 640.
		# The picker column moved right to 700 to make room for this.
		position = { 650 200 }
		size = { 40 300 }
		allow_outside = yes

		# --- selection is a FAITH ----------------------------------------
		widget = {
			name = "sg_c_fc_ylabel_end_faith"
			size = { 100% 100% }
			allow_outside = yes

			# Gated on the SEGMENT count, not just on "something is selected".
			# Zero segments means no line was drawn, and a y/x label with no line
			# under it is an annotation of nothing - which is exactly what a
			# one-snapshot campaign used to show. N snapshots give N-1 segments,
			# so this is false for both the "no snapshots yet" and the "only one
			# snapshot" cases, and stays false for an object whose OWN history is
			# one point long even when the campaign's is fifty.
			visible = "[And( GetGlobalVariable( 'sg_selected_faith' ).IsSet, GreaterThan_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)0' ) )]"
			datamodel = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties' )]"

			item = {
				widget = {
					size = { 40 20 }
					allow_outside = yes

					visible = "[EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, Subtract_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties' ) ), '(int32)1' ) )]"
					position = "[FloatToCVector2f( '(float)0', Subtract_float( Subtract_float( '(float)300', Min_float( Multiply_float( IntToFloat( FixedPointToInt( Scope.GetValue ) ), '(float)0.3' ), '(float)300' ) ), '(float)10' ) )]"

					# Left-aligned, so this one starts against the plot edge.
					text_single = {
						position = { 0 0 }
						text = "[FixedPointToInt( Scope.GetValue )]"
						default_format = "#light_background"
						using = Text_Light_Background_Overrides
						alwaystransparent = yes
					}
				}
			}
		}

		# --- selection is a CULTURE --------------------------------------
		widget = {
			name = "sg_c_fc_ylabel_end_culture"
			size = { 100% 100% }
			allow_outside = yes

			# Gated on the SEGMENT count, not just on "something is selected".
			# Zero segments means no line was drawn, and a y/x label with no line
			# under it is an annotation of nothing - which is exactly what a
			# one-snapshot campaign used to show. N snapshots give N-1 segments,
			# so this is false for both the "no snapshots yet" and the "only one
			# snapshot" cases, and stays false for an object whose OWN history is
			# one point long even when the campaign's is fifty.
			visible = "[And( GetGlobalVariable( 'sg_selected_culture' ).IsSet, GreaterThan_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)0' ) )]"
			datamodel = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties' )]"

			item = {
				widget = {
					size = { 40 20 }
					allow_outside = yes

					visible = "[EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, Subtract_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties' ) ), '(int32)1' ) )]"
					position = "[FloatToCVector2f( '(float)0', Subtract_float( Subtract_float( '(float)300', Min_float( Multiply_float( IntToFloat( FixedPointToInt( Scope.GetValue ) ), '(float)0.3' ), '(float)300' ) ), '(float)10' ) )]"

					text_single = {
						position = { 0 0 }
						text = "[FixedPointToInt( Scope.GetValue )]"
						default_format = "#light_background"
						using = Text_Light_Background_Overrides
						alwaystransparent = yes
					}
				}
			}
		}
	}

	### THE X AXIS - IN-GAME YEARS ##############################################
	# Labels only. There is still no y AXIS - no ticks, no gridlines, no scale.
# The two y labels above annotate the line's endpoints only.
	#
	# ---------------------------------------------------------------------
	# WHERE THE YEAR COMES FROM
	# ---------------------------------------------------------------------
	# Each entry of the per-object year list is sg_snapshot_index * 10000 +
	# year, written by sg_engine_append_point_effect at the same moment the
	# point itself is written. The year is READ FROM THE GAME at snapshot time
	# (current_year), not derived as start_year + index - deriving it breaks on
	# any save that has had console-forced snapshots run against it, because
	# the index advances for those too while the calendar does not.
	#
	# The list is per object rather than global so that an object whose history
	# begins mid-campaign is labelled with ITS OWN years. The plot stretches
	# each object's own series across the full 600px, so a culture created at
	# snapshot 50 has its first point at x = 0, and a global list read by
	# position would label that point with snapshot 1's year.
	#
	# ---------------------------------------------------------------------
	# SPACING - MUST MATCH THE LINE, OR THE LABELS DRIFT OFF THE POINTS
	# ---------------------------------------------------------------------
	# The step divisor is GetDataModelSize of the SEGMENT list, character for
	# character the same expression the line's from/to use. It is NOT the year
	# list's own size: N snapshots give N year entries but only N-1 segments,
	# so dividing by the year count would compress every label by a factor of
	# (N-1)/N and the drift would grow along the axis.
	#
	# Label i therefore sits at i * 600/(N-1), which puts the first at x = 0
	# and the last at x = 600 - exactly the two ends of the line.
	#
	# The 20px left shift centres a four-digit year on its point rather than
	# starting it there. It is half the declared 40px box.
	#
	# ---------------------------------------------------------------------
	# HOW MANY LABELS
	# ---------------------------------------------------------------------
	# Every Nth snapshot, N = max( year_count / 6, 1 ), so the axis carries
	# roughly six to twelve labels at any history length instead of one per
	# snapshot - which at 100+ snapshots would be unreadable.
	#
	# Max_int32( ..., 1 ) is doing real work twice over: it stops Modulo_int32
	# ever being handed a 0 (undefined), which is reachable for any history
	# shorter than six snapshots, AND it makes the result independent of
	# whether Divide_int32 truncates or rounds - something this project has
	# never established. Either behaviour just shifts the label count a little.
	#
	# Both blocks below are near-identical for the same reason every other pair
	# in this window is: the selection is either a Faith or a Culture, the type
	# is carried structurally by two mutually-exclusive globals, and CK3 has no
	# polymorphic accessor that would let one block serve both.
	widget = {
		name = "sg_c_fc_xaxis"
		position = { 46 504 }
		size = { 600 20 }
		allow_outside = yes

		# --- selection is a FAITH ----------------------------------------
		widget = {
			name = "sg_c_fc_xaxis_faith"
			size = { 100% 100% }
			allow_outside = yes

			# Gated on the SEGMENT count, not just on "something is selected".
			# Zero segments means no line was drawn, and a y/x label with no line
			# under it is an annotation of nothing - which is exactly what a
			# one-snapshot campaign used to show. N snapshots give N-1 segments,
			# so this is false for both the "no snapshots yet" and the "only one
			# snapshot" cases, and stays false for an object whose OWN history is
			# one point long even when the campaign's is fifty.
			visible = "[And( GetGlobalVariable( 'sg_selected_faith' ).IsSet, GreaterThan_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)0' ) )]"
			datamodel = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_years' )]"

			item = {
				widget = {
					size = { 40 20 }
					allow_outside = yes

					visible = "[EqualTo_int32( Modulo_int32( PdxGuiWidget.GetIndexInDataModel, Max_int32( Divide_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_years' ) ), '(int32)6' ), '(int32)1' ) ), '(int32)0' )]"
					position = "[FloatToCVector2f( Subtract_float( Multiply_float( IntToFloat( PdxGuiWidget.GetIndexInDataModel ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), '(float)20' ), '(float)0' )]"

					text_single = {
						position = { 0 0 }
						text = "[Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)10000' )]"
						default_format = "#light_background"
						using = Text_Light_Background_Overrides
						alwaystransparent = yes
					}
				}
			}
		}

		# --- selection is a CULTURE --------------------------------------
		widget = {
			name = "sg_c_fc_xaxis_culture"
			size = { 100% 100% }
			allow_outside = yes

			# Gated on the SEGMENT count, not just on "something is selected".
			# Zero segments means no line was drawn, and a y/x label with no line
			# under it is an annotation of nothing - which is exactly what a
			# one-snapshot campaign used to show. N snapshots give N-1 segments,
			# so this is false for both the "no snapshots yet" and the "only one
			# snapshot" cases, and stays false for an object whose OWN history is
			# one point long even when the campaign's is fifty.
			visible = "[And( GetGlobalVariable( 'sg_selected_culture' ).IsSet, GreaterThan_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)0' ) )]"
			datamodel = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_years' )]"

			item = {
				widget = {
					size = { 40 20 }
					allow_outside = yes

					visible = "[EqualTo_int32( Modulo_int32( PdxGuiWidget.GetIndexInDataModel, Max_int32( Divide_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_years' ) ), '(int32)6' ), '(int32)1' ) ), '(int32)0' )]"
					position = "[FloatToCVector2f( Subtract_float( Multiply_float( IntToFloat( PdxGuiWidget.GetIndexInDataModel ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), '(float)20' ), '(float)0' )]"

					text_single = {
						position = { 0 0 }
						text = "[Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)10000' )]"
						default_format = "#light_background"
						using = Text_Light_Background_Overrides
						alwaystransparent = yes
					}
				}
			}
		}
	}
	### THE CURRENT SELECTION ##################################################
	# Moved here from above the plot, where it read "SHOWING: Catholicism". The
	# left half is a sheet carrying nothing but the graph now, so the one piece of
	# text that says what the graph IS belongs with the control that chose it.
	#
	# It keeps the window's light default text colour: the picker column still
	# sits on the black window background, and only the left half is paper.
	#
	# Three mutually exclusive lines rather than one, for the reason every pair in
	# this file exists - a selection is either a Faith or a Culture, the type is
	# carried structurally by two globals of which only one is ever set, and CK3
	# has no polymorphic name accessor that would let one line serve both. The
	# third covers neither being set, which is how a fresh campaign starts: there
	# is deliberately no default selection, because seeding one would mean naming
	# a faith in script, which is the hardcode phase 5 existed to remove.
	widget = {
		name = "sg_c_fc_selected_name"
		position = { 700 14 }
		size = { 430 24 }

		text_single = {
			position = { 0 0 }
			visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
			text = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.GetNameNoTooltip]"
			default_format = "#bold"
		}
		text_single = {
			position = { 0 0 }
			visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
			text = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.GetNameNoTooltip]"
			default_format = "#bold"
		}
		text_single = {
			position = { 0 0 }
			visible = "[And( Not( GetGlobalVariable( 'sg_selected_faith' ).IsSet ), Not( GetGlobalVariable( 'sg_selected_culture' ).IsSet ) )]"
			text = "SG_C_FC_LBL_NOSEL"
		}
	}

	### THE PICKER ##############################################################
	# Every faith and every culture that has ever held a county, read straight
	# out of the two registries that sg_engine_register_object_effect
	# rebuilds each snapshot. No faith or culture is named anywhere here, and
	# nothing needs special-casing for objects created mid-campaign - a reformed
	# faith or a hybrid culture appears on its next snapshot because the registry
	# is rebuilt rather than appended to.
	#
	# Every row is a click target; clicking one drives the plot on the left.
	# Selection needs a played character - see the Observer-mode note above.
	#
	# The three mechanisms this column rests on, all verified in-game 2026-09-13:
	#
	#   the counts      GetGlobalList reaches the registries.
	#
	#   the names       datacontext = "[Scope.Faith]" promotes a stored scope
	#                   back to a real Faith. This is the load-bearing assumption
	#                   of the whole design; blank names with non-zero counts
	#                   would mean it had failed.
	#
	#   pts / seg       Faith.MakeScope.GetList('name') reads that object's OWN
	#                   per-object list, which is what makes a global mirror
	#                   unnecessary. "pts" equals "snapshots taken" for any
	#                   object tracked since game start, and "seg" is one less
	#                   (N snapshots produce N-1 segments).
	#
	# Row order is registry insertion order and is deliberately left alone:
	# faiths come out grouped by religion (every_religion_global -> every_faith),
	# cultures in a flat sweep. It is stable between snapshots. CK3 datamodels
	# have no sort, so any other ordering would have to be produced script-side.


	scrollbox = {
		name = "sg_c_fc_generic_scroll"
		# Was { 700 72 } 430x604, under a "PICK ONE" heading and a row of
		# faith/culture counts. Both are gone; the list starts directly under
		# the selection name and still ends at y 676.
		position = { 700 46 }
		size = { 430 630 }

		blockoverride "scrollbox_content"
		{
			vbox = {
				name = "sg_c_fc_generic_stack"

				# =========================================================
				# GROUPED ROWS: a datamodel inside a datamodel.
				#
				# The outer one walks a GROUP REGISTRY - a global list whose
				# entries are group objects. The inner one walks that group
				# object's OWN member list, read back with the same
				# <Type>.MakeScope.GetList( 'name' ) hop every plot expression
				# in this file already uses. sg_engine_snapshot.txt builds both.
				#
				# The member lists are pre-filtered script-side to objects this
				# mod actually tracks, so there is no per-row `visible` here and
				# no group can render an empty body under its header. That is
				# the reason the membership is stored rather than asked for at
				# draw time: the GUI could enumerate a religion's faiths itself
				# with Religion.GetFaiths, but it would get ALL of them, and a
				# datamodel cannot be filtered.
				#
				# WITHIN a group, and BETWEEN groups, rows are still in registry
				# insertion order - CK3 datamodels have no sort, so grouping is
				# as far as ordering can be pushed from here. Within a religion
				# that is every_faith order; between religions it is
				# every_religion_global order. Stable between snapshots.
				#
				# The rows themselves are UNCHANGED from the flat version: same
				# button_standard carrying the datacontext as the item's root,
				# same onclick, same four absolutely-positioned columns. Only
				# what feeds them moved. The one addition is margin_left on the
				# row, so members sit indented under their header the way the
				# ruler designer's own grouped lists indent theirs
				# (window_ruler_designer.gui:815 margin_left = 30,
				# :962 margin_left = 50).
				#
				# The four columns moved left by 20 to pay for that indent, so
				# the rightmost one still ends inside the 420px column.

				widget = {
					size = { 420 20 }
					text_single = {
						position = { 0 0 }
						text = "SG_C_FC_LBL_FAITHCOLS"
					}
				}

				# --- every faith, grouped under its religion -----------------
				# No faith and no religion is named anywhere here.
				vbox = {
					name = "sg_c_fc_faith_groups"
					datamodel = "[GetGlobalList( 'sg_religion_registry' )]"

					item = {
						vbox = {
							name = "sg_c_fc_faith_group"

							# NOTE THE DATACONTEXT THAT IS *NOT* HERE.
							# The obvious shape is datacontext = "[Scope.Religion]"
							# on this vbox, header and rows both reading off it.
							# It is avoided on purpose, and the reason is the one
							# thing about this layout that could fail SILENTLY.
							#
							# A row further down declares datacontext = "[Scope.Faith]"
							# and a culture row declares "[Scope.Culture]". Put a
							# datacontext of the SAME TYPE on an ancestor and the
							# row's own declaration has to shadow it. Shadowing is
							# how datacontext is understood to work - nearest
							# declaration wins - but it is NOT SOMETHING THIS
							# PROJECT HAS ANY EVIDENCE FOR. A scan of game/gui,
							# jomini/gui and all 28 installed workshop mods finds 44
							# sites that nest a datacontext of the same type, and
							# every single one of them re-declares the IDENTICAL
							# expression (china_official.gui:372/375,
							# window_senate.gui:1339/1350 and so on). Not one nests
							# two DIFFERENT objects of one type, so not one of them
							# shows which wins.
							#
							# If the outer won, every row in a group would render
							# the GROUP's name instead of its own - a list that
							# looks populated and plausible and is wrong. That is
							# not a thing to find out in a screenshot.
							#
							# So no type is declared twice anywhere in this column.
							# Each one appears exactly once in its chain:
							#   Religion       on the header widget only
							#   Faith          on the row button only
							#   CulturePillar  on the culture header widget only
							#   Culture        on the culture row button only
							# and everything between them is reached through `Scope`,
							# which the datamodel rebinds per item by its own
							# mechanism - the mechanism the plot and the old flat
							# picker in this same file already run on.

							# The header. A plain widget, not a button: with the
							# collapsing left out there is nothing for a click
							# to do, and a header that highlights on hover but
							# does nothing on click reads as broken.
							widget = {
								size = { 420 24 }
								datacontext = "[Scope.Religion]"

								text_single = {
									position = { 4 0 }
									text = "SG_C_FC_HDR_RELIGION"
									default_format = "#bold"
								}
							}

							# This religion's tracked faiths, and only those.
							#
							# Scope.GetList rather than Religion.MakeScope.GetList:
							# the registry entry IS a Scope already, so the promote
							# and the MakeScope hop back would cancel out. The rows
							# elsewhere in this file say <Type>.MakeScope.GetList
							# only because they start from a typed object.
							# Scope.GetList( Arg0 ) - data_types_script.txt:3429.
							vbox = {
								name = "sg_c_fc_faith_group_rows"
								datamodel = "[Scope.GetList( 'sg_faithculture_group_members' )]"

								item = {
									# THE BUTTON IS THE ITEM'S ROOT AND CARRIES THE DATACONTEXT.
									# An earlier version made this a plain `widget` holding the
									# datacontext, with a bare `button` nested inside it under the
									# text. That parsed clean - gui_warnings.log stayed empty and
									# error.log showed nothing - and did absolutely nothing on click.
									# Every working example of a clickable datamodel row puts the
									# button at the top of the item and the datacontext on it:
									#   workshop 3192256710,
									#   ATE_character_selection_two_options.gui:25-32
									#   vanilla window_activity_planner.gui:275-320
									# so this now matches that shape exactly.
									#
									# button_standard rather than a bare `button` for the same reason:
									# it is what both of those working examples use, and it brings
									# hover and pressed states for free, so a row visibly reacts to
									# the mouse. That reaction is itself the first diagnostic - if a
									# row does not light up on hover, the click is not reaching the
									# widget at all and nothing downstream matters.
									button_standard = {
										size = { 400 26 }
										margin_left = 20
										datacontext = "[Scope.Faith]"

										onclick = "[GetScriptedGui( 'sg_c_faithculture_select_faith_gui' ).Execute( GuiScope.SetRoot( Faith.MakeScope ).End )]"

										# NO `down =` HERE ON PURPOSE. A previous version lit the
										# selected row via a query-only scripted GUI's IsShown. It was
										# evaluated once per row per frame and produced 97,758 script
										# errors in six seconds - which is how the null-character root
										# was finally found, so it did its job - but it is not worth
										# re-adding until the selection itself is working. The
										# selection's name above this list already says what is plotted.

										tooltip = "SG_C_FC_TT_CLICK"

										# The columns keep the exact fixed-size / absolutely-positioned
										# layout that was arrived at the hard way (hbox and vbox ignore
										# declared x positions - see README_LINE_GRAPH_PROTOTYPE.md,
										# "Layout corrections"). They just live inside the button now.
										# alwaystransparent on the wrapper keeps the whole text block
										# from swallowing the click.
										widget = {
											size = { 100% 100% }
											alwaystransparent = yes

											# The three numeric columns that used to sit at x 180, 260 and 330
											# - counties now, plain points, segments - are parked in
											# sg_debug_widgets.gui.bak with the rest of the debug readouts.
											# A picker row is just a name now.
											# x 10, not 0. At 0 the name sits hard against the button's own
											# frame with no breathing room, so the row reads as clipped rather
											# than as indented. This is INSIDE the button, so it is separate
											# from the margin_left = 20 above, which indents the whole row
											# under its group header.
											text_single = {
												position = { 10 0 }
												text = "[Faith.GetNameNoTooltip]"
												alwaystransparent = yes
											}
										}
									}
								}
							}
						}
					}
				}

				# --- every culture, grouped under its heritage ---------------
				widget = {
					size = { 420 20 }
					text_single = {
						position = { 0 0 }
						text = "SG_C_FC_LBL_CULTCOLS"
					}
				}

				# The outer datamodel here holds CULTURES, not heritages, and
				# that is not a mistake. Script has no way to reach a culture's
				# heritage as a scope, so each entry is a DELEGATE culture
				# standing in for the heritage it carries - the full reasoning
				# is in sg_c_faithculture_collect.txt. The header below does the
				# hop script cannot, with Culture.GetHeritage, which is the
				# GUI-side link vanilla itself uses
				# (faith_view_l_english.yml:17).
				vbox = {
					name = "sg_c_fc_culture_groups"
					datamodel = "[GetGlobalList( 'sg_heritage_registry' )]"

					item = {
						vbox = {
							name = "sg_c_fc_culture_group"

							# No datacontext here either, and here it matters
							# twice over - see the long note on the faith group
							# above. The header promotes STRAIGHT PAST the
							# delegate culture to its heritage, so the type it
							# declares is CulturePillar and the word Culture is
							# never bound on an ancestor of the rows at all.
							widget = {
								size = { 420 24 }
								datacontext = "[Scope.Culture.GetHeritage]"

								text_single = {
									position = { 4 0 }
									text = "SG_C_FC_HDR_HERITAGE"
									default_format = "#bold"
								}
							}

							# Every tracked culture sharing the delegate's
							# heritage - the delegate itself included, which is
							# why it needs no row of its own above.
							vbox = {
								name = "sg_c_fc_culture_group_rows"
								datamodel = "[Scope.GetList( 'sg_faithculture_group_members' )]"

								item = {
									# Same shape, and same reasons, as the faith rows above.
									button_standard = {
										size = { 400 26 }
										margin_left = 20
										datacontext = "[Scope.Culture]"

										onclick = "[GetScriptedGui( 'sg_c_faithculture_select_culture_gui' ).Execute( GuiScope.SetRoot( Culture.MakeScope ).End )]"

										tooltip = "SG_C_FC_TT_CLICK"

										widget = {
											size = { 100% 100% }
											alwaystransparent = yes

											# The three numeric columns that used to sit at x 180, 260 and 330
											# - counties now, plain points, segments - are parked in
											# sg_debug_widgets.gui.bak with the rest of the debug readouts.
											# A picker row is just a name now.
											# x 10, not 0. At 0 the name sits hard against the button's own
											# frame with no breathing room, so the row reads as clipped rather
											# than as indented. This is INSIDE the button, so it is separate
											# from the margin_left = 20 above, which indents the whole row
											# under its group header.
											text_single = {
												position = { 10 0 }
												text = "[Culture.GetNameNoTooltip]"
												alwaystransparent = yes
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

}
