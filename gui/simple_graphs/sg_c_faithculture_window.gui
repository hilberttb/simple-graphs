###############################################################################
# Simple Graphs - connected line graph, driven by a faith/culture picker.
#
# Two columns:
#   x  20 ..  640   the plot. Shows whichever faith or culture is selected.
#   x 660 .. 1090   the picker. Every row is a click target.
#
# There is exactly ONE plot. Comparing two series side by side is deliberately
# not a feature - the window briefly showed two during the migration off the
# catholic hardcode, and that scaffolding is gone.
#
# Selection REQUIRES A PLAYED CHARACTER. A scripted GUI's Execute does not run
# at all in Observer mode, so the rows are inert there; the window says so on
# screen. Everything else here is a pure read and works in Observer. Full
# reasoning in common/scripted_guis/sg_c_faithculture_select.txt.
#
# ---------------------------------------------------------------------------
# COORDINATES
# ---------------------------------------------------------------------------
# Script hands the GUI one packed number per segment:
#     entry = snapshot_index * 1000000 + y_start * 1000 + y_end
# with y already a pixel offset in a 300px-tall plot and already flipped for
# GUI coordinates. See sg_engine_append_point_effect.
#
#     y_start = Modulo_int32( Divide_int32( v, 1000 ), 1000 )
#     y_end   = Modulo_int32( v, 1000 )
#     x_start = index * STEP    x_end = (index + 1) * STEP
#
# Divide_int32 is only used to shift the packed value right by one field, and
# it is safe whether it truncates or rounds to nearest: y_end is at most 300,
# so the discarded remainder is never at or above half a unit and can never
# round the quotient up. Nothing here depends on knowing which it does.
#
# x comes from PdxGuiWidget.GetIndexInDataModel, which is real and widely used
# in vanilla (hud.gui:7952, hud_ruler_objective.gui:198, and ~20 more sites),
# so no script-side x list is needed.
#
# ---------------------------------------------------------------------------
# THE X STEP AUTO-FITS. It used to be a hardcoded 30px.
# ---------------------------------------------------------------------------
#     STEP = Divide_float( '(float)600',
#                IntToFloat( Max_int32( GetDataModelSize( <the segment list> ),
#                                       '(int32)1' ) ) )
#
# At a fixed 30px the plot held only 20 segments before the line ran past the
# plot area and then past the window itself. The series now always fills the
# 600px plot exactly and CAN NEVER LEAVE IT, whatever the snapshot count.
#
# The accepted trade, decided deliberately: the x axis COMPRESSES as snapshots
# accumulate instead of staying 30px per year. Spacing is therefore not
# comparable between two objects with different history lengths.
#
# Max_int32( ..., 1 ) is the divide-by-zero guard. An object with a single
# snapshot has ZERO segments, and 600/0 would be undefined; the guard makes the
# step 600 and the lone point sits at x = 0, which is correct because there is
# no line to draw anyway.
#
# DO NOT "fix" the compression by wrapping the plot in a horizontally scrolling
# scrollbox. That was tried on 2026-09-12 and does not work: no scrollbar
# appeared, nothing was clipped, and the line drew straight across the whole
# screen at 43 segments. The data-bound size on the content widget DID take
# effect and the numbers panel in this same window scrolls vertically without
# trouble, so the failure is specific to scrolling a container of `line`
# widgets. Vanilla's domicile precedent proves lines RENDER inside a scrollbox,
# not that they SCROLL inside one. This auto-fit is what replaced that idea.
#
# The divisor is the SEGMENT list, not the year list - see the x-axis block
# below, whose labels must land on the same step or they drift off the points.
#
# ---------------------------------------------------------------------------
# SCROLLAREAS
# ---------------------------------------------------------------------------
# GUI_RESEARCH.md open question #5 asked whether a `line` survives inside a
# scrollarea. Vanilla already answers it: vbox_domicile_upgrade_tree
# (window_domicile.gui:3508) contains data-bound `line` widgets and is rendered
# inside a scrollbox via blockoverride "scrollbox_content"
# (window_domicile.gui:3177-3199), with both scrollbars set to as_needed. So
# lines do render inside a scrollarea in shipping code. The plot below is still
# kept out of any scrollarea, to keep the prototype's failure modes few.
#
# Note also that the vanilla templates which live inside that scrollbox
# (Line_Domicile_*) do NOT set effectname, i.e. they use the default line
# effect rather than PdxGuiLineScreenSpace. The templates below follow them.
###############################################################################

# The line style lives in gui/simple_graphs/sg_engine_plot.gui as the template
# sg_engine_line_data. Cross-file template references are load-order safe -
# that file records the vanilla evidence.

window = {
	name = "sg_c_faithculture_window"
	datacontext = "[GetVariableSystem]"

	parentanchor = center
	# 680x620 -> 1180x700 -> 1750x700 while two plots were on screen for the
	# catholic migration -> 1090x700 now that only the selection plot remains.
	# The plot keeps its 600x300 size: the 300px height is fixed by the script's
	# 0-300 y scale and must not change without changing
	# sg_engine_append_point_effect's Y_MAX argument to match.
	size = { 1090 700 }
	layer = windows_layer
	movable = yes

	visible = "[GetVariableSystem.Exists( 'sg_window_open' )]"

	# Background as a child widget rather than a property on the window itself,
	# so nothing depends on a template this prototype has not verified.
	widget = {
		size = { 100% 100% }
		background = {
			texture = "gfx/interface/colors/black.dds"
			alpha = 0.92
		}
	}

	### header ###################################################################
	text_single = {
		position = { 20 14 }
		text = "SG_C_FC_WINDOW_TITLE"
	}

	button_standard = {
		parentanchor = top|right
		position = { -16 10 }
		size = { 90 28 }
		text = "SG_ENGINE_CLOSE"
		onclick = "[GetVariableSystem.Toggle( 'sg_window_open' )]"
	}

	### THE PLOT ################################################################
	# Names no faith and no culture anywhere. Plots whatever was last clicked in
	# the picker on the right.
	#
	# The 600x300 size is not arbitrary: the 300px height is fixed by the 0-300
	# pixel y scale that sg_engine_append_point_effect encodes into
	# every packed segment, and must not change without changing that effect.
	#
	# -------------------------------------------------------------------------
	# HOW A SELECTION GETS HERE
	# -------------------------------------------------------------------------
	# Clicking a row runs common/scripted_guis/sg_c_faithculture_select.txt,
	# which writes the clicked object's SCOPE into a global variable. The chain
	# back out, every link confirmed in logs/data_types/:
	#
	#   GetGlobalVariable( 'name' )  Global promote -> Scope  script.txt:364
	#     .Faith / .Culture          Promote -> Faith/Culture script.txt:2923 / :2853
	#       .MakeScope               Promote -> Scope         uncategorized.txt:61019 / :49608
	#         .GetList( 'name' )     Function -> datamodel    script.txt:3429
	#
	# Only the FIRST link is new. The other three are exactly what the picker
	# column on the right already does per row, and they were verified in-game on
	# 2026-09-13 (real names, pts = snapshots taken, seg = pts - 1). The first
	# link is the same shape as the already-working
	# GetGlobalVariable( 'sg_snapshot_index' ).GetValue in the counter
	# row of the left column.
	#
	# -------------------------------------------------------------------------
	# WHY EVERYTHING BELOW EXISTS TWICE
	# -------------------------------------------------------------------------
	# A selection is either a Faith or a Culture, and `line` needs one datamodel.
	# The alternative design - one generic global plus a type flag, letting the
	# GUI ask whether .Faith "works" on it - was rejected because a mistyped
	# promote's behaviour is not confirmable: `Scope.<Type>.IsValid` appears
	# ZERO times across game/gui, jomini/gui, clausewitz/gui and all 28 installed
	# workshop mods. Nothing in shipped code ever calls a Scope type-promote
	# where the type might be wrong, so there is no evidence it degrades quietly
	# rather than erroring or spamming.
	#
	# So the type is carried structurally instead: two globals, only one ever set
	# at a time, each only ever holding its own type. Each pair of widgets below
	# is guarded by `.IsSet` on its own global, which is a plain bool
	# (Scope.IsSet, data_types_script.txt:3550) on a type the widget already
	# knows. The two are mutually exclusive by construction, so exactly one plot
	# is ever on screen - the "one graph at a time" scope limit is enforced by
	# the data model rather than by a rule someone has to remember.
	#
	# The cost is that the faith block and the culture block below are textually
	# near-identical. That is the accepted trade.
	#
	# -------------------------------------------------------------------------
	# THE LINE EXPRESSIONS ARE UNCHANGED FROM THE PROTOTYPE
	# -------------------------------------------------------------------------
	# The `from`/`to` expressions below are character-for-character what the
	# original catholic-hardcoded plot used; only the datamodel source differs.
	# That equality was the whole basis of the migration check: on 2026-09-13,
	# selecting Catholic here reproduced the hardcoded plot segment for segment,
	# and every number column matched value for value, which is what licensed
	# deleting the hardcode.
	#
	# The faith and culture blocks below are near-identical rather than sharing a
	# template. See "WHY EVERYTHING BELOW EXISTS TWICE" above - they bind
	# different datamodels and only one is ever visible.
	text_single = {
		position = { 20 46 }
		text = "SG_C_FC_LBL_SELECTED"
	}

	widget = {
		name = "sg_c_fc_selected_name"
		position = { 120 46 }
		size = { 520 20 }

		text_single = {
			position = { 0 0 }
			visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
			text = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.GetNameNoTooltip]"
		}
		text_single = {
			position = { 0 0 }
			visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
			text = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.GetNameNoTooltip]"
		}
		# Neither set - i.e. nothing has been clicked yet in this campaign. There
		# is deliberately no default selection: seeding one would mean naming a
		# faith in script, which is the hardcode this column exists to remove.
		text_single = {
			position = { 0 0 }
			visible = "[And( Not( GetGlobalVariable( 'sg_selected_faith' ).IsSet ), Not( GetGlobalVariable( 'sg_selected_culture' ).IsSet ) )]"
			text = "SG_C_FC_LBL_NOSEL"
		}
	}

	### Observer-mode warning ##################################################
	# Selection genuinely does not work without a player character. In Observer
	# mode a scripted GUI's Execute does not run AT ALL - confirmed 2026-09-13 by
	# clicking four different routes into script, including two that never touch
	# GetPlayer, and getting zero debug output from any of them; the moment a
	# character was selected, all four fired. So this is not something the mod can
	# route around, and the honest thing is to say so rather than let the picker
	# look broken. See the header of sg_c_faithculture_select.txt.
	#
	# Everything else in this window still works in Observer - the picker lists,
	# the counts and all the number columns are pure reads. Only clicking is
	# blocked, so a plot selected before entering Observer keeps rendering.
	# GetPlayer.IsValid as an availability test is the vanilla-style guard and is
	# what workshop mod 3118461885 uses on its own floating button
	# (HRT_floating_button.gui:5).
	text_single = {
		position = { 20 76 }
		visible = "[Not( GetPlayer.IsValid )]"
		text = "SG_C_FC_LBL_OBSERVER"
	}

	text_single = {
		position = { 20 116 }
		text = "SG_C_FC_LBL_SELPLOT"
	}

	widget = {
		name = "sg_c_fc_sel_plot_area"
		position = { 40 138 }
		size = { 600 300 }
		allow_outside = yes

		background = {
			texture = "gfx/interface/colors/black.dds"
			alpha = 0.45
		}

		# --- selection is a FAITH --------------------------------------------
		widget = {
			name = "sg_c_fc_sel_series_faith"
			size = { 100% 100% }
			allow_outside = yes

			visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
			datamodel = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' )]"

			item = {
				container = {
					allow_outside = yes

					line = {
						using = sg_engine_line_data
						from = "[FloatToCVector2f( Multiply_float( IntToFloat( PdxGuiWidget.GetIndexInDataModel ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), IntToFloat( Modulo_int32( Divide_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ), '(int32)1000' ) ) )]"
						to = "[FloatToCVector2f( Multiply_float( IntToFloat( Add_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)1' ) ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), IntToFloat( Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ) ) )]"
					}
				}
			}
		}

		# --- selection is a CULTURE ------------------------------------------
		widget = {
			name = "sg_c_fc_sel_series_culture"
			size = { 100% 100% }
			allow_outside = yes

			visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
			datamodel = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' )]"

			item = {
				container = {
					allow_outside = yes

					line = {
						using = sg_engine_line_data
						from = "[FloatToCVector2f( Multiply_float( IntToFloat( PdxGuiWidget.GetIndexInDataModel ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), IntToFloat( Modulo_int32( Divide_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ), '(int32)1000' ) ) )]"
						to = "[FloatToCVector2f( Multiply_float( IntToFloat( Add_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)1' ) ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), IntToFloat( Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ) ) )]"
					}
				}
			}
		}
	}

	### THE X AXIS - IN-GAME YEARS ##############################################
	# Labels only. There is deliberately NO y axis.
	#
	# ---------------------------------------------------------------------
	# WHERE THE YEAR COMES FROM
	# ---------------------------------------------------------------------
	# Each entry of the per-object year list is sg_snapshot_index * 10000 +
	# year, written by sg_engine_append_point_effect at the same moment the
	# point itself is written. The year is READ FROM THE GAME at snapshot time
	# (current_year), not derived as start_year + index - deriving it breaks on
	# any save that has had console-forced snapshots run against it, because
	# the index advances for those too while the calendar does not.
	#
	# The list is per object rather than global so that an object whose history
	# begins mid-campaign is labelled with ITS OWN years. The plot stretches
	# each object's own series across the full 600px, so a culture created at
	# snapshot 50 has its first point at x = 0, and a global list read by
	# position would label that point with snapshot 1's year.
	#
	# ---------------------------------------------------------------------
	# SPACING - MUST MATCH THE LINE, OR THE LABELS DRIFT OFF THE POINTS
	# ---------------------------------------------------------------------
	# The step divisor is GetDataModelSize of the SEGMENT list, character for
	# character the same expression the line's from/to use. It is NOT the year
	# list's own size: N snapshots give N year entries but only N-1 segments,
	# so dividing by the year count would compress every label by a factor of
	# (N-1)/N and the drift would grow along the axis.
	#
	# Label i therefore sits at i * 600/(N-1), which puts the first at x = 0
	# and the last at x = 600 - exactly the two ends of the line.
	#
	# The 20px left shift centres a four-digit year on its point rather than
	# starting it there. It is half the declared 40px box.
	#
	# ---------------------------------------------------------------------
	# HOW MANY LABELS
	# ---------------------------------------------------------------------
	# Every Nth snapshot, N = max( year_count / 6, 1 ), so the axis carries
	# roughly six to twelve labels at any history length instead of one per
	# snapshot - which at 100+ snapshots would be unreadable.
	#
	# Max_int32( ..., 1 ) is doing real work twice over: it stops Modulo_int32
	# ever being handed a 0 (undefined), which is reachable for any history
	# shorter than six snapshots, AND it makes the result independent of
	# whether Divide_int32 truncates or rounds - something this project has
	# never established. Either behaviour just shifts the label count a little.
	#
	# Both blocks below are near-identical for the same reason every other pair
	# in this window is: the selection is either a Faith or a Culture, the type
	# is carried structurally by two mutually-exclusive globals, and CK3 has no
	# polymorphic accessor that would let one block serve both.
	widget = {
		name = "sg_c_fc_xaxis"
		position = { 40 442 }
		size = { 600 20 }
		allow_outside = yes

		# --- selection is a FAITH ----------------------------------------
		widget = {
			name = "sg_c_fc_xaxis_faith"
			size = { 100% 100% }
			allow_outside = yes

			visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
			datamodel = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_years' )]"

			item = {
				widget = {
					size = { 40 20 }
					allow_outside = yes

					visible = "[EqualTo_int32( Modulo_int32( PdxGuiWidget.GetIndexInDataModel, Max_int32( Divide_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_years' ) ), '(int32)6' ), '(int32)1' ) ), '(int32)0' )]"
					position = "[FloatToCVector2f( Subtract_float( Multiply_float( IntToFloat( PdxGuiWidget.GetIndexInDataModel ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), '(float)20' ), '(float)0' )]"

					text_single = {
						position = { 0 0 }
						text = "[Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)10000' )]"
						alwaystransparent = yes
					}
				}
			}
		}

		# --- selection is a CULTURE --------------------------------------
		widget = {
			name = "sg_c_fc_xaxis_culture"
			size = { 100% 100% }
			allow_outside = yes

			visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
			datamodel = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_years' )]"

			item = {
				widget = {
					size = { 40 20 }
					allow_outside = yes

					visible = "[EqualTo_int32( Modulo_int32( PdxGuiWidget.GetIndexInDataModel, Max_int32( Divide_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_years' ) ), '(int32)6' ), '(int32)1' ) ), '(int32)0' )]"
					position = "[FloatToCVector2f( Subtract_float( Multiply_float( IntToFloat( PdxGuiWidget.GetIndexInDataModel ), Divide_float( '(float)600', IntToFloat( Max_int32( GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) ), '(int32)1' ) ) ) ), '(float)20' ), '(float)0' )]"

					text_single = {
						position = { 0 0 }
						text = "[Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)10000' )]"
						alwaystransparent = yes
					}
				}
			}
		}
	}

	### the number columns ######################################################
	# idx / packed entry / y start / y end, and idx / stored value / counties,
	# both bound to the current selection and decoded with the same expressions
	# the line itself uses.
	#
	# These are what make the selector verifiable rather than merely plausible:
	# if clicking a different row changes these numbers, the binding really did
	# move, and a line that happens to look similar cannot be mistaken for a line
	# that never changed. They are also how the catholic migration was checked.
	# Cheap to keep, and the first thing to read if a plot ever looks wrong.
	widget = {
		name = "sg_c_fc_sel_counters"
		position = { 40 468 }
		size = { 600 20 }

		text_single = {
			position = { 0 0 }
			text = "SG_ENGINE_LBL_SEGCOUNT"
		}
		text_single = {
			position = { 80 0 }
			visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
			text = "[GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) )]"
		}
		text_single = {
			position = { 80 0 }
			visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
			text = "[GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) )]"
		}

		text_single = {
			position = { 150 0 }
			text = "SG_ENGINE_LBL_PLAINCOUNT"
		}
		text_single = {
			position = { 250 0 }
			visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
			text = "[GetDataModelSize( GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties' ) )]"
		}
		text_single = {
			position = { 250 0 }
			visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
			text = "[GetDataModelSize( GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties' ) )]"
		}

		# Kept from the deleted catholic column because it is not
		# catholic-specific and it is the reference the two counts above are
		# checked against: an object tracked since game start should show
		# "plain points" equal to this, and "segments" one less.
		text_single = {
			position = { 330 0 }
			text = "SG_ENGINE_LBL_SNAPSHOTS"
		}
		text_single = {
			position = { 460 0 }
			visible = "[GetGlobalVariable( 'sg_snapshot_index' ).IsSet]"
			text = "[GetGlobalVariable( 'sg_snapshot_index' ).GetValue]"
		}
	}

	scrollbox = {
		name = "sg_c_fc_sel_numbers_scroll"
		position = { 40 494 }
		size = { 600 136 }

		blockoverride "scrollbox_content"
		{
			vbox = {
				name = "sg_c_fc_sel_numbers_stack"

				# --- segments, decoded exactly as the line decodes them -------
				widget = {
					size = { 540 20 }
					text_single = {
						position = { 0 0 }
						text = "SG_ENGINE_LBL_SEGCOLS"
					}
				}

				vbox = {
					name = "sg_c_fc_sel_segment_rows_faith"
					visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
					datamodel = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' )]"

					item = {
						widget = {
							size = { 540 20 }

							text_single = {
								position = { 0 0 }
								text = "[PdxGuiWidget.GetIndexInDataModel]"
							}
							text_single = {
								position = { 45 0 }
								text = "[Scope.GetValue]"
							}
							text_single = {
								position = { 180 0 }
								text = "[Modulo_int32( Divide_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ), '(int32)1000' )]"
							}
							text_single = {
								position = { 260 0 }
								text = "[Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' )]"
							}
						}
					}
				}

				vbox = {
					name = "sg_c_fc_sel_segment_rows_culture"
					visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
					datamodel = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' )]"

					item = {
						widget = {
							size = { 540 20 }

							text_single = {
								position = { 0 0 }
								text = "[PdxGuiWidget.GetIndexInDataModel]"
							}
							text_single = {
								position = { 45 0 }
								text = "[Scope.GetValue]"
							}
							text_single = {
								position = { 180 0 }
								text = "[Modulo_int32( Divide_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' ), '(int32)1000' )]"
							}
							text_single = {
								position = { 260 0 }
								text = "[Modulo_int32( FixedPointToInt( Scope.GetValue ), '(int32)1000' )]"
							}
						}
					}
				}

				# --- plain points --------------------------------------------
				widget = {
					size = { 540 20 }
					text_single = {
						position = { 0 0 }
						text = "SG_C_FC_LBL_PLAINCOLS"
					}
				}

				vbox = {
					name = "sg_c_fc_sel_plain_rows_faith"
					visible = "[GetGlobalVariable( 'sg_selected_faith' ).IsSet]"
					datamodel = "[GetGlobalVariable( 'sg_selected_faith' ).Faith.MakeScope.GetList( 'sg_faithculture_counties' )]"

					item = {
						widget = {
							size = { 540 20 }

							text_single = {
								position = { 0 0 }
								text = "[PdxGuiWidget.GetIndexInDataModel]"
							}
							text_single = {
								position = { 45 0 }
								text = "[Scope.GetValue]"
							}
							text_single = {
								position = { 180 0 }
								text = "[FixedPointToInt( Scope.GetValue )]"
							}
						}
					}
				}

				vbox = {
					name = "sg_c_fc_sel_plain_rows_culture"
					visible = "[GetGlobalVariable( 'sg_selected_culture' ).IsSet]"
					datamodel = "[GetGlobalVariable( 'sg_selected_culture' ).Culture.MakeScope.GetList( 'sg_faithculture_counties' )]"

					item = {
						widget = {
							size = { 540 20 }

							text_single = {
								position = { 0 0 }
								text = "[PdxGuiWidget.GetIndexInDataModel]"
							}
							text_single = {
								position = { 45 0 }
								text = "[Scope.GetValue]"
							}
							text_single = {
								position = { 180 0 }
								text = "[FixedPointToInt( Scope.GetValue )]"
							}
						}
					}
				}
			}
		}
	}

	### THE PICKER ##############################################################
	# Every faith and every culture that has ever held a county, read straight
	# out of the two registries that sg_engine_register_object_effect
	# rebuilds each snapshot. No faith or culture is named anywhere here, and
	# nothing needs special-casing for objects created mid-campaign - a reformed
	# faith or a hybrid culture appears on its next snapshot because the registry
	# is rebuilt rather than appended to.
	#
	# Every row is a click target; clicking one drives the plot on the left.
	# Selection needs a played character - see the Observer-mode note above.
	#
	# The three mechanisms this column rests on, all verified in-game 2026-09-13:
	#
	#   the counts      GetGlobalList reaches the registries.
	#
	#   the names       datacontext = "[Scope.Faith]" promotes a stored scope
	#                   back to a real Faith. This is the load-bearing assumption
	#                   of the whole design; blank names with non-zero counts
	#                   would mean it had failed.
	#
	#   pts / seg       Faith.MakeScope.GetList('name') reads that object's OWN
	#                   per-object list, which is what makes a global mirror
	#                   unnecessary. "pts" equals "snapshots taken" for any
	#                   object tracked since game start, and "seg" is one less
	#                   (N snapshots produce N-1 segments).
	#
	# Row order is registry insertion order and is deliberately left alone:
	# faiths come out grouped by religion (every_religion_global -> every_faith),
	# cultures in a flat sweep. It is stable between snapshots. CK3 datamodels
	# have no sort, so any other ordering would have to be produced script-side.
	text_single = {
		position = { 660 14 }
		text = "SG_C_FC_LBL_PICKER"
	}

	widget = {
		name = "sg_c_fc_generic_counters"
		position = { 660 46 }
		size = { 430 20 }

		# RUNG A
		text_single = {
			position = { 0 0 }
			text = "SG_C_FC_LBL_FAITHCOUNT"
		}
		text_single = {
			position = { 110 0 }
			text = "[GetDataModelSize( GetGlobalList( 'sg_faith_registry' ) )]"
		}
		text_single = {
			position = { 180 0 }
			text = "SG_C_FC_LBL_CULTCOUNT"
		}
		text_single = {
			position = { 300 0 }
			text = "[GetDataModelSize( GetGlobalList( 'sg_culture_registry' ) )]"
		}
	}

	scrollbox = {
		name = "sg_c_fc_generic_scroll"
		position = { 660 72 }
		size = { 430 604 }

		blockoverride "scrollbox_content"
		{
			vbox = {
				name = "sg_c_fc_generic_stack"

				widget = {
					size = { 420 20 }
					text_single = {
						position = { 0 0 }
						text = "SG_C_FC_LBL_FAITHCOLS"
					}
				}

				# --- every faith, with no faith named anywhere ---------------
				vbox = {
					name = "sg_c_fc_all_faith_rows"
					datamodel = "[GetGlobalList( 'sg_faith_registry' )]"

					item = {
						# THE BUTTON IS THE ITEM'S ROOT AND CARRIES THE DATACONTEXT.
						# An earlier version made this a plain `widget` holding the
						# datacontext, with a bare `button` nested inside it under the
						# text. That parsed clean - gui_warnings.log stayed empty and
						# error.log showed nothing - and did absolutely nothing on click.
						# Every working example of a clickable datamodel row puts the
						# button at the top of the item and the datacontext on it:
						#   workshop 3192256710,
						#   ATE_character_selection_two_options.gui:25-32
						#   vanilla window_activity_planner.gui:275-320
						# so this now matches that shape exactly.
						#
						# button_standard rather than a bare `button` for the same reason:
						# it is what both of those working examples use, and it brings
						# hover and pressed states for free, so a row visibly reacts to
						# the mouse. That reaction is itself the first diagnostic - if a
						# row does not light up on hover, the click is not reaching the
						# widget at all and nothing downstream matters.
						button_standard = {
							size = { 420 26 }
							datacontext = "[Scope.Faith]"

							onclick = "[GetScriptedGui( 'sg_c_faithculture_select_faith_gui' ).Execute( GuiScope.SetRoot( Faith.MakeScope ).End )]"

							# NO `down =` HERE ON PURPOSE. A previous version lit the
							# selected row via a query-only scripted GUI's IsShown. It was
							# evaluated once per row per frame and produced 97,758 script
							# errors in six seconds - which is how the null-character root
							# was finally found, so it did its job - but it is not worth
							# re-adding until the selection itself is working. The
							# "SHOWING:" line above the plot already names the selection.

							tooltip = "SG_C_FC_TT_CLICK"

							# The columns keep the exact fixed-size / absolutely-positioned
							# layout that was arrived at the hard way (hbox and vbox ignore
							# declared x positions - see README_LINE_GRAPH_PROTOTYPE.md,
							# "Layout corrections"). They just live inside the button now.
							# alwaystransparent on the wrapper keeps the whole text block
							# from swallowing the click.
							widget = {
								size = { 100% 100% }
								alwaystransparent = yes

								text_single = {
									position = { 0 0 }
									text = "[Faith.GetNameNoTooltip]"
									alwaystransparent = yes
								}
								text_single = {
									position = { 200 0 }
									visible = "[Faith.MakeScope.GetVariable( 'sg_faithculture_counties_now' ).IsSet]"
									text = "[FixedPointToInt( Faith.MakeScope.GetVariable( 'sg_faithculture_counties_now' ).GetValue )]"
									alwaystransparent = yes
								}
								text_single = {
									position = { 280 0 }
									text = "[GetDataModelSize( Faith.MakeScope.GetList( 'sg_faithculture_counties' ) )]"
									alwaystransparent = yes
								}
								text_single = {
									position = { 350 0 }
									text = "[GetDataModelSize( Faith.MakeScope.GetList( 'sg_faithculture_counties_seg' ) )]"
									alwaystransparent = yes
								}
							}
						}
					}
				}

				# --- every culture, same shape ------------------------------
				widget = {
					size = { 420 20 }
					text_single = {
						position = { 0 0 }
						text = "SG_C_FC_LBL_CULTCOLS"
					}
				}

				vbox = {
					name = "sg_c_fc_all_culture_rows"
					datamodel = "[GetGlobalList( 'sg_culture_registry' )]"

					item = {
						# THE BUTTON IS THE ITEM'S ROOT AND CARRIES THE DATACONTEXT.
						# An earlier version made this a plain `widget` holding the
						# datacontext, with a bare `button` nested inside it under the
						# text. That parsed clean - gui_warnings.log stayed empty and
						# error.log showed nothing - and did absolutely nothing on click.
						# Every working example of a clickable datamodel row puts the
						# button at the top of the item and the datacontext on it:
						#   workshop 3192256710,
						#   ATE_character_selection_two_options.gui:25-32
						#   vanilla window_activity_planner.gui:275-320
						# so this now matches that shape exactly.
						#
						# button_standard rather than a bare `button` for the same reason:
						# it is what both of those working examples use, and it brings
						# hover and pressed states for free, so a row visibly reacts to
						# the mouse. That reaction is itself the first diagnostic - if a
						# row does not light up on hover, the click is not reaching the
						# widget at all and nothing downstream matters.
						button_standard = {
							size = { 420 26 }
							datacontext = "[Scope.Culture]"

							onclick = "[GetScriptedGui( 'sg_c_faithculture_select_culture_gui' ).Execute( GuiScope.SetRoot( Culture.MakeScope ).End )]"

							# NO `down =` HERE ON PURPOSE. A previous version lit the
							# selected row via a query-only scripted GUI's IsShown. It was
							# evaluated once per row per frame and produced 97,758 script
							# errors in six seconds - which is how the null-character root
							# was finally found, so it did its job - but it is not worth
							# re-adding until the selection itself is working. The
							# "SHOWING:" line above the plot already names the selection.

							tooltip = "SG_C_FC_TT_CLICK"

							# The columns keep the exact fixed-size / absolutely-positioned
							# layout that was arrived at the hard way (hbox and vbox ignore
							# declared x positions - see README_LINE_GRAPH_PROTOTYPE.md,
							# "Layout corrections"). They just live inside the button now.
							# alwaystransparent on the wrapper keeps the whole text block
							# from swallowing the click.
							widget = {
								size = { 100% 100% }
								alwaystransparent = yes

								text_single = {
									position = { 0 0 }
									text = "[Culture.GetNameNoTooltip]"
									alwaystransparent = yes
								}
								text_single = {
									position = { 200 0 }
									visible = "[Culture.MakeScope.GetVariable( 'sg_faithculture_counties_now' ).IsSet]"
									text = "[FixedPointToInt( Culture.MakeScope.GetVariable( 'sg_faithculture_counties_now' ).GetValue )]"
									alwaystransparent = yes
								}
								text_single = {
									position = { 280 0 }
									text = "[GetDataModelSize( Culture.MakeScope.GetList( 'sg_faithculture_counties' ) )]"
									alwaystransparent = yes
								}
								text_single = {
									position = { 350 0 }
									text = "[GetDataModelSize( Culture.MakeScope.GetList( 'sg_faithculture_counties_seg' ) )]"
									alwaystransparent = yes
								}
							}
						}
					}
				}
			}
		}
	}

}
